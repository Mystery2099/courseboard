{
	"name": "courseboard",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": ">=24"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --env-file-if-exists=.env server/ProductionServer.js",
		"prepare": "pnpm run i18n:compile && (svelte-kit sync || echo '')",
		"check": "pnpm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale --silent",
		"i18n:check": "inlang check --project ./project.inlang",
		"i18n:translate": "tsx scripts/i18n/MessageTranslator.ts",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit --run && pnpm run test:e2e",
		"test:e2e": "playwright install && playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/cli": "3.6.0",
		"@inlang/paraglide-js": "3.2.2",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"clsx": "^2.1.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@clerk/localizations": "4.24.8",
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/literata": "5.3.0",
		"@fontsource-variable/space-grotesk": "5.3.0",
		"@fontsource/ibm-plex-mono": "5.3.0",
		"@tanstack/svelte-hotkeys": "0.25.1",
		"@tanstack/svelte-query": "^6.3.10",
		"bits-ui": "^2.20.5",
		"lucide-svelte": "^1.0.1",
		"markdown-it": "15.0.3",
		"mongodb": "^7.8.0",
		"socket.io": "^4.8.4",
		"socket.io-client": "^4.8.4",
		"svelte-clerk": "^1.3.0",
		"zod": "^4.6.7"
	}
}
